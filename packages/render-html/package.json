{
  "name": "@wirenav/render-html",
  "version": "0.0.0",
  "description": "IR (+ optional SnapshotMap) → standalone interactive HTML. Consumes core only; never imports an extractor.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@wirenav/core": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "happy-dom": "^15.11.0",
    "tsup": "^8.3.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  }
}
